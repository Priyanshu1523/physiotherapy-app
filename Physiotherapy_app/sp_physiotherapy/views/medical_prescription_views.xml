<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                  PRESCRIPTION SEARCH VIEW                    -->
    <!-- ============================================================ -->

    <record id="view_medical_prescription_search" model="ir.ui.view">
        <field name="name">medical.prescription.search</field>
        <field name="model">medical.prescription</field>
        <field name="arch" type="xml">
            <search string="Search Prescriptions">
                <field name="sequence_no"/>
                <field name="patient_id"/>
                <field name="prescribed_doctor_id"/>
                <field name="appointment_id"/>

                <filter name="filter_today"
                        string="Today"
                        domain="[('prescription_date', '=', context_today())]"/>
                <filter name="filter_yesterday"
                        string="Yesterday"
                        domain="[('prescription_date', '=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_new"
                        string="New"
                        domain="[('state', '=', 'new')]"/>
                <filter name="filter_prescribed"
                        string="Prescribed"
                        domain="[('state', '=', 'prescribed')]"/>
                <filter name="filter_invoiced"
                        string="Invoiced"
                        domain="[('state', '=', 'invoiced')]"/>

                <separator/>

                <group>
                    <filter name="group_by_doctor"
                            string="Doctor"
                            domain="[]" context="{'group_by': 'prescribed_doctor_id'}"/>
                    <filter name="group_by_patient"
                            string="Patient"
                            domain="[]" context="{'group_by': 'patient_id'}"/>
                    <filter name="group_by_state"
                            string="Status"
                            domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date"
                            string="Date"
                            domain="[]" context="{'group_by': 'prescription_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                   PRESCRIPTION FORM VIEW                     -->
    <!-- ============================================================ -->

    <record id="view_medical_prescription_form" model="ir.ui.view">
        <field name="name">medical.prescription.form</field>
        <field name="model">medical.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">

                <header>
                    <button name="action_mark_prescribed"
                            string="Prescribe"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_print_prescription"
                            string="Print Prescription"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'new'"/>
                    <button name="action_create_invoices"
                            string="Create Invoices"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'prescribed'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="new,prescribed,invoiced"/>
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices"
                                type="object"
                                string="Invoices"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="state != 'invoiced'"/>
                        <button name="action_open_payments"
                                type="object"
                                string="Payments"
                                class="oe_stat_button"
                                icon="fa-money"
                                invisible="state != 'invoiced'"/>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="sequence_no" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Appointment &amp; Patient">
                            <field name="appointment_id"
                                   readonly="state == 'invoiced'"
                                   domain="[('state', '=', 'done')]"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="prescribed_doctor_id" readonly="1"/>
                            <field name="prescription_date"
                                   readonly="state == 'invoiced'"/>
                        </group>
                        <group string="Treatment">
                            <field name="treatment_id"
                                   readonly="state == 'invoiced'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="treatment_cost" widget="monetary"
                                   readonly="1"/>
                            <field name="referred_doctor_id"
                                   readonly="state == 'invoiced'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Prescribed Medicines" name="medicine_lines">
                            <field name="medicine_line_ids"
                                   readonly="state == 'invoiced'">
                                <list string="Medicines" editable="bottom">
                                    <field name="medicament_id"/>
                                    <field name="generic_name" readonly="1"/>
                                    <field name="dosage_strength" readonly="1"/>
                                    <field name="form"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" readonly="1"/>
                                    <field name="before_food"/>
                                    <field name="morning"/>
                                    <field name="afternoon"/>
                                    <field name="evening"/>
                                    <field name="night"/>
                                    <field name="duration_days"/>
                                </list>
                            </field>
                        </page>

                        <page string="Follow-up" name="follow_up">
                            <group>
                                <group>
                                    <field name="next_appointment_date" widget="datetime"
                                           options="{'minute_step': 30}"
                                           readonly="state == 'invoiced'"/>
                                </group>
                            </group>
                            <field name="notes"
                                   placeholder="Additional notes, follow-up instructions..."
                                   readonly="state == 'invoiced'"/>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                   PRESCRIPTION LIST VIEW                     -->
    <!-- ============================================================ -->

    <record id="view_medical_prescription_list" model="ir.ui.view">
        <field name="name">medical.prescription.list</field>
        <field name="model">medical.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions"
                  decoration-info="state == 'new'"
                  decoration-success="state == 'prescribed'"
                  decoration-muted="state == 'invoiced'">
                <field name="sequence_no"/>
                <field name="patient_id"/>
                <field name="prescribed_doctor_id"/>
                <field name="treatment_id" optional="show"/>
                <field name="prescription_date"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'new'"
                       decoration-info="state == 'prescribed'"
                       decoration-success="state == 'invoiced'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                  PRESCRIPTION ACTION WINDOW                  -->
    <!-- ============================================================ -->

    <record id="action_medical_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">medical.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="search_view_id" ref="view_medical_prescription_search"/>
    </record>

</odoo>
