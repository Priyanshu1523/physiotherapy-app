<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                    TREATMENT LIST VIEW                       -->
    <!-- ============================================================ -->

    <record id="view_medical_treatment_list" model="ir.ui.view">
        <field name="name">medical.treatment.list</field>
        <field name="model">medical.treatment</field>
        <field name="arch" type="xml">
            <list string="Treatments" editable="bottom">
                <field name="name" required="True"/>
                <field name="treatment_category_id"/>
                <field name="cost"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    TREATMENT FORM VIEW                       -->
    <!-- ============================================================ -->

    <record id="view_medical_treatment_form" model="ir.ui.view">
        <field name="name">medical.treatment.form</field>
        <field name="model">medical.treatment</field>
        <field name="arch" type="xml">
            <form string="Treatment">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="treatment_category_id"/>
                        </group>
                        <group>
                            <field name="cost"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                   TREATMENT ACTION WINDOW                    -->
    <!-- ============================================================ -->

    <record id="action_medical_treatment" model="ir.actions.act_window">
        <field name="name">Treatments</field>
        <field name="res_model">medical.treatment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
