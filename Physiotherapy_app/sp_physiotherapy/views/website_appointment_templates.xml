var selectedDial = '+91';

document.addEventListener('DOMContentLoaded', function () {
    renderCountryList(COUNTRIES);
});

function renderCountryList(list) {
    var ul = document.getElementById('country-list');
    ul.innerHTML = '';
    list.forEach(function (c) {
        var li = document.createElement('li');
        li.style.cssText = 'display:flex;align-items:center;gap:10px;padding:9px 14px;cursor:pointer;font-size:.88rem;transition:background .15s;';
        li.innerHTML = '<span style="font-size:1.2rem;">' + c.flag + '</span>' +
                       '<span style="flex:1;">' + c.name + '</span>' +
                       '<span style="color:#0d9488;font-weight:600;">' + c.dial + '</span>';
        li.onmouseover = function () { this.style.background = '#f0fdfa'; };
        li.onmouseout  = function () { this.style.background = ''; };
        li.onclick     = function () { selectCountry(c); };
        ul.appendChild(li);
    });
}

function selectCountry(c) {
    selectedDial = c.dial;
    document.getElementById('appt-flag-display').textContent = c.flag;
    document.getElementById('appt-dial-display').textContent = c.dial;
    document.getElementById('appt-country-code-val').value   = c.dial;
    document.getElementById('appt-flag-dropdown').style.display = 'none';
    updateCombinedPhone();
}

function toggleFlagDropdown() {
    var dd = document.getElementById('appt-flag-dropdown');
    dd.style.display = (dd.style.display === 'none') ? 'block' : 'none';
    if (dd.style.display === 'block') {
        document.getElementById('flag-search').focus();
    }
}

function filterCountries(query) {
    var q = query.toLowerCase();
    var filtered = COUNTRIES.filter(function (c) {
        return c.name.toLowerCase().indexOf(q) !== -1 || c.dial.indexOf(q) !== -1;
    });
    renderCountryList(filtered);
}

function updateCombinedPhone() {
    var num = document.getElementById('appt-phone').value.trim();
    document.getElementById('appt-phone-combined').value = selectedDial + ' ' + num;
}

// Close dropdown when clicking outside
document.addEventListener('click', function (e) {
    var selector = document.getElementById('appt-flag-selector');
    var dropdown = document.getElementById('appt-flag-dropdown');
    if (dropdown && selector) {
        if (!selector.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.style.display = 'none';
        }
    }
});
