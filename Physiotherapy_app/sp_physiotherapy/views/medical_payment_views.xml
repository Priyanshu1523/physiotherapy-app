<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--           PAYMENT LOG LIST (inherit account.payment)         -->
    <!-- ============================================================ -->

    <record id="view_account_payment_physio_list" model="ir.ui.view">
        <field name="name">account.payment.physio.list.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Patient</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_company_currency_signed']" position="attributes">
                <attribute name="string">Amount Paid</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="treatment_name" optional="hide"/>
                <field name="treatment_cost" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='amount_company_currency_signed']" position="after">
                <field name="amount_due" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                  PAYMENT LOG ACTION WINDOW                   -->
    <!-- ============================================================ -->

    <record id="action_medical_payment_log" model="ir.actions.act_window">
        <field name="name">Payment Log</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
