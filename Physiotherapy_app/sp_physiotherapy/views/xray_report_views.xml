<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                   X-RAY REPORT FORM VIEW                     -->
    <!-- ============================================================ -->

    <record id="view_xray_report_form" model="ir.ui.view">
        <field name="name">xray.report.form</field>
        <field name="model">xray.report</field>
        <field name="arch" type="xml">
            <form string="X-Ray Report">
                <sheet>
                    <field name="scan_image" widget="image"
                           class="oe_avatar" options="{'preview_image': 'scan_image'}"/>
                    <div class="oe_title">
                        <label for="patient_id"/>
                        <h1><field name="patient_id" placeholder="Select patient..."
                                   domain="[('is_patient', '=', True)]"
                                   options="{'no_create': True}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_date"/>
                        </group>
                        <group>
                            <field name="image_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Findings" name="findings">
                            <field name="description" nolabel="1"
                                   placeholder="Findings, observations..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                   X-RAY REPORT LIST VIEW                     -->
    <!-- ============================================================ -->

    <record id="view_xray_report_list" model="ir.ui.view">
        <field name="name">xray.report.list</field>
        <field name="model">xray.report</field>
        <field name="arch" type="xml">
            <list string="X-Ray Reports" default_order="report_date desc, id desc">
                <field name="patient_id"/>
                <field name="report_date"/>
                <field name="description"/>
                <field name="scan_image" widget="image" options="{'size': [0, 40]}"/>
                <field name="image_filename" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                  X-RAY REPORT SEARCH VIEW                    -->
    <!-- ============================================================ -->

    <record id="view_xray_report_search" model="ir.ui.view">
        <field name="name">xray.report.search</field>
        <field name="model">xray.report</field>
        <field name="arch" type="xml">
            <search string="Search X-Ray Reports">
                <field name="patient_id"/>
                <field name="report_date"/>

                <group>
                    <filter name="group_by_patient"
                            string="Patient"
                            domain="[]" context="{'group_by': 'patient_id'}"/>
                    <filter name="group_by_date"
                            string="Report Date"
                            domain="[]" context="{'group_by': 'report_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                 X-RAY REPORT ACTION WINDOW                   -->
    <!-- ============================================================ -->

    <record id="action_xray_report" model="ir.actions.act_window">
        <field name="name">X-Ray Reports</field>
        <field name="res_model">xray.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xray_report_search"/>
    </record>

</odoo>