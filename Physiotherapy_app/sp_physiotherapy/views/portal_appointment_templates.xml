<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         APPOINTMENT LIST PAGE
         Groups: Today's Queue, Upcoming, Completed, Cancelled
         ================================================================ -->
    <template id="portal_appointment_templates" name="My Appointments">
        <t t-call="portal.portal_layout">

            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Appointments</t>
            </t>

            <!-- Role badge -->
            <div class="mb-3">
                <t t-if="portal_role == 'admin'">
                    <span class="badge bg-danger fs-6">Administrator View</span>
                </t>
                <t t-elif="portal_role == 'doctor'">
                    <span class="badge bg-primary fs-6">Practitioner View</span>
                </t>
                <t t-else="">
                    <span class="badge bg-success fs-6">Patient View</span>
                </t>
            </div>

            <!-- =========================================================
                 TODAY'S QUEUE
                 ========================================================= -->
            <div class="mb-4">
                <h5 class="fw-bold text-warning">Today's Queue</h5>
                <t t-if="not waiting_list">
                    <div class="alert alert-secondary">
                        No appointments in the queue today.
                    </div>
                </t>
                <t t-if="waiting_list" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Queue #</th>
                            <th>Appointment No.</th>
                            <th>Patient Code</th>
                            <th>Doctor</th>
                            <th>Scheduled Time</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="waiting_list" t-as="app">
                            <tr>
                                <td>
                                    <span class="badge bg-dark rounded-pill px-3">
                                        <t t-esc="app_index + 1"/>
                                    </span>
                                </td>
                                <td>
                                    <strong>
                                        <a t-att-href="'/my/appointments/%s' % app.id"
                                           class="text-decoration-none">
                                            <t t-esc="app.appointment_no"/>
                                        </a>
                                    </strong>
                                </td>
                                <td>
                                    <t t-esc="app.patient_code or '-'"/>
                                </td>
                                <td>
                                    <t t-esc="app.doctor_id.name"/>
                                </td>
                                <td>
                                    <span t-field="app.appointment_date"
                                          t-options="{'widget': 'datetime'}"/>
                                </td>
                                <td class="text-center">
                                    <span t-att-class="'badge px-3 py-2 ' + {
                                        'confirmed': 'bg-success',
                                        'in_progress': 'bg-primary',
                                    }.get(app.state, 'bg-secondary')">
                                        <t t-esc="{
                                            'confirmed': 'Confirmed',
                                            'in_progress': 'In Progress',
                                        }.get(app.state, app.state)"/>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a t-att-href="'/my/appointments/%s' % app.id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </div>

            <!-- =========================================================
                 UPCOMING APPOINTMENTS
                 ========================================================= -->
            <div class="mb-4">
                <h5 class="fw-bold text-primary">Upcoming Appointments</h5>
                <t t-if="not upcoming">
                    <div class="alert alert-secondary">
                        No upcoming appointments scheduled.
                    </div>
                </t>
                <t t-if="upcoming" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>#</th>
                            <th>Appointment No.</th>
                            <th>Patient Code</th>
                            <th>Doctor</th>
                            <th>Date &amp; Time</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="upcoming" t-as="app">
                            <tr>
                                <td>
                                    <t t-esc="app_index + 1"/>
                                </td>
                                <td>
                                    <strong>
                                        <a t-att-href="'/my/appointments/%s' % app.id"
                                           class="text-decoration-none">
                                            <t t-esc="app.appointment_no"/>
                                        </a>
                                    </strong>
                                </td>
                                <td>
                                    <t t-esc="app.patient_code or '-'"/>
                                </td>
                                <td>
                                    <t t-esc="app.doctor_id.name"/>
                                </td>
                                <td>
                                    <span t-field="app.appointment_date"
                                          t-options="{'widget': 'datetime'}"/>
                                </td>
                                <td class="text-center">
                                    <span t-att-class="'badge px-3 py-2 ' + {
                                        'draft': 'bg-secondary',
                                        'confirmed': 'bg-success',
                                    }.get(app.state, 'bg-secondary')">
                                        <t t-esc="{
                                            'draft': 'Draft',
                                            'confirmed': 'Confirmed',
                                        }.get(app.state, app.state)"/>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a t-att-href="'/my/appointments/%s' % app.id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </div>

            <!-- =========================================================
                 COMPLETED APPOINTMENTS
                 ========================================================= -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark">Completed Appointments</h5>
                <t t-if="not past">
                    <div class="alert alert-secondary">
                        No completed appointments on record.
                    </div>
                </t>
                <t t-if="past" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>#</th>
                            <th>Appointment No.</th>
                            <th>Patient Code</th>
                            <th>Doctor</th>
                            <th>Date &amp; Time</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="past" t-as="app">
                            <tr>
                                <td>
                                    <t t-esc="app_index + 1"/>
                                </td>
                                <td>
                                    <strong>
                                        <a t-att-href="'/my/appointments/%s' % app.id"
                                           class="text-decoration-none">
                                            <t t-esc="app.appointment_no"/>
                                        </a>
                                    </strong>
                                </td>
                                <td>
                                    <t t-esc="app.patient_code or '-'"/>
                                </td>
                                <td>
                                    <t t-esc="app.doctor_id.name"/>
                                </td>
                                <td>
                                    <span t-field="app.appointment_date"
                                          t-options="{'widget': 'datetime'}"/>
                                </td>
                                <td class="text-center">
                                    <span class="badge px-3 py-2 bg-dark">Completed</span>
                                </td>
                                <td class="text-center">
                                    <a t-att-href="'/my/appointments/%s' % app.id"
                                       class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </div>

            <!-- =========================================================
                 CANCELLED APPOINTMENTS
                 ========================================================= -->
            <div class="mb-4">
                <h5 class="fw-bold text-danger">Cancelled Appointments</h5>
                <t t-if="not cancelled">
                    <div class="alert alert-secondary">
                        No cancelled appointments.
                    </div>
                </t>
                <t t-if="cancelled" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>#</th>
                            <th>Appointment No.</th>
                            <th>Patient Code</th>
                            <th>Doctor</th>
                            <th>Date &amp; Time</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="cancelled" t-as="app">
                            <tr>
                                <td>
                                    <t t-esc="app_index + 1"/>
                                </td>
                                <td>
                                    <strong>
                                        <a t-att-href="'/my/appointments/%s' % app.id"
                                           class="text-decoration-none">
                                            <t t-esc="app.appointment_no"/>
                                        </a>
                                    </strong>
                                </td>
                                <td>
                                    <t t-esc="app.patient_code or '-'"/>
                                </td>
                                <td>
                                    <t t-esc="app.doctor_id.name"/>
                                </td>
                                <td>
                                    <span t-field="app.appointment_date"
                                          t-options="{'widget': 'datetime'}"/>
                                </td>
                                <td class="text-center">
                                    <span class="badge px-3 py-2 bg-danger">Cancelled</span>
                                </td>
                                <td class="text-center">
                                    <a t-att-href="'/my/appointments/%s' % app.id"
                                       class="btn btn-sm btn-outline-danger">
                                        View
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </div>

        </t>
    </template>

    <!-- ================================================================
         APPOINTMENT DETAIL PAGE
         ================================================================ -->
    <template id="portal_appointment_detail" name="Appointment Detail">
        <t t-call="portal.portal_layout">
            <div class="container py-4">

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/my/appointments">My Appointments</a>
                        </li>
                        <li class="breadcrumb-item active">
                            <t t-esc="appointment.appointment_no"/>
                        </li>
                    </ol>
                </nav>

                <!-- Status tracker -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <t t-foreach="[
                                ('draft', 'Draft'),
                                ('confirmed', 'Confirmed'),
                                ('in_progress', 'In Progress'),
                                ('done', 'Completed'),
                            ]" t-as="step">
                                <div class="text-center flex-fill">
                                    <div t-att-class="'rounded-circle d-inline-flex align-items-center justify-content-center mb-1 ' + (
                                        'bg-success text-white' if appointment.state != 'cancelled' and
                                        ['draft','confirmed','in_progress','done'].index(appointment.state) >=
                                        ['draft','confirmed','in_progress','done'].index(step[0])
                                        else 'bg-danger text-white' if appointment.state == 'cancelled'
                                        else 'bg-light border text-muted'
                                    )" style="width:44px;height:44px;font-size:12px;line-height:44px;">
                                        <t t-esc="step_index + 1"/>
                                    </div>
                                    <div class="small fw-bold mt-1">
                                        <t t-esc="step[1]"/>
                                    </div>
                                </div>
                                <t t-if="not step_last">
                                    <div class="flex-grow-1 border-top mx-1"/>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Appointment information card -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            Appointment -
                            <t t-esc="appointment.appointment_no"/>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Patient</div>
                                    <div class="fw-bold">
                                        <t t-esc="appointment.patient_id.name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Patient Code</div>
                                    <div class="fw-bold">
                                        <t t-esc="appointment.patient_code or 'N/A'"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Practitioner</div>
                                    <div class="fw-bold">
                                        <t t-esc="appointment.doctor_id.name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Date &amp; Time</div>
                                    <div class="fw-bold">
                                        <span t-field="appointment.appointment_date"
                                              t-options="{'widget': 'datetime'}"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Duration</div>
                                    <div class="fw-bold">
                                        <t t-esc="appointment.slot_duration or 'N/A'"/>
                                        <t t-if="appointment.slot_duration"> min</t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Status</div>
                                    <div>
                                        <span t-att-class="'badge px-3 py-2 ' + {
                                            'draft': 'bg-secondary',
                                            'confirmed': 'bg-success',
                                            'in_progress': 'bg-primary',
                                            'done': 'bg-dark',
                                            'cancelled': 'bg-danger',
                                        }.get(appointment.state, 'bg-secondary')">
                                            <t t-esc="{
                                                'draft': 'Draft',
                                                'confirmed': 'Confirmed',
                                                'in_progress': 'In Progress',
                                                'done': 'Completed',
                                                'cancelled': 'Cancelled',
                                            }.get(appointment.state, appointment.state)"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Consultation Fee</div>
                                    <div class="fw-bold text-success">
                                        <t t-if="appointment.consultation_fee">
                                            <t t-esc="appointment.consultation_fee"
                                               t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </t>
                                        <t t-else="">N/A</t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/my/appointments" class="btn btn-outline-secondary">
                        Back to Appointments
                    </a>
                    <t t-if="appointment.zoom_meeting_url and appointment.state in ('confirmed', 'in_progress')">
                        <a t-att-href="appointment.zoom_meeting_url"
                           target="_blank" rel="noopener"
                           class="btn btn-primary">
                            <i class="fa fa-video-camera me-1"/>Join Zoom Meeting
                        </a>
                    </t>
                    <t t-if="appointment.state in ('draft', 'confirmed')">
                        <form t-att-action="'/my/appointments/%s/cancel' % appointment.id"
                              method="post" class="d-inline">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                Cancel Appointment
                            </button>
                        </form>
                    </t>
                    <a href="/book-appointment" class="btn btn-outline-primary">
                        Book Another Appointment
                    </a>
                </div>

            </div>
        </t>
    </template>

    <!-- ================================================================
         WAITING AREA SCREEN (PUBLIC)
         Privacy-first: shows queue numbers and token IDs only, no names
         ================================================================ -->
    <template id="waiting_screen_template" name="Waiting Area Screen">
        <t t-call="website.layout">
            <div style="background:#0d1b2a; min-height:100vh; padding:30px;">

                <!-- Header -->
                <div class="text-center mb-4">
                    <h1 style="color:#ffffff; font-size:2.5rem; font-weight:800; letter-spacing:3px;">
                        APPOINTMENT QUEUE
                    </h1>
                    <p style="color:#90caf9; font-size:1.1rem;">
                        Today -
                        <strong style="color:#ffffff;">
                            <t t-esc="now"/>
                        </strong>
                    </p>
                    <hr style="border-color:#1e3a5f;"/>
                </div>

                <!-- No appointments -->
                <t t-if="not appointments">
                    <div class="text-center mt-5">
                        <h3 style="color:#90caf9;">No patients currently in the queue</h3>
                    </div>
                </t>

                <!-- Queue table (privacy-safe: queue number + token only) -->
                <t t-if="appointments">
                    <div class="table-responsive">
                        <table class="table table-borderless" style="color:#ffffff;">
                            <thead>
                                <tr style="background:#1e3a5f; font-size:1.1rem;
                                           text-transform:uppercase; letter-spacing:1px;">
                                    <th class="py-3 px-4">Queue #</th>
                                    <th class="py-3 px-4">Token</th>
                                    <th class="py-3 px-4">Scheduled Time</th>
                                    <th class="py-3 px-4 text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="appointments" t-as="appt">
                                    <tr t-att-style="'background:%s; border-bottom:1px solid #1e3a5f;' % (
                                        '#1a3a1a' if appt.state == 'in_progress' else '#1a1a2e'
                                    )">
                                        <td class="py-3 px-4">
                                            <span style="background:#1e3a5f; padding:8px 18px;
                                                         border-radius:8px; font-weight:800;
                                                         font-size:1.3rem; color:#ffffff;">
                                                <t t-esc="appt_index + 1"/>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span style="background:#1e3a5f; padding:6px 16px;
                                                         border-radius:20px; font-weight:700;
                                                         color:#90caf9; font-size:1.1rem;">
                                                <t t-esc="appt.appointment_no"/>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4" style="font-size:1.05rem;">
                                            <span t-field="appt.appointment_date"
                                                  t-options="{'widget': 'datetime',
                                                              'format': 'hh:mm a'}"/>
                                        </td>
                                        <td class="py-3 px-4 text-center">
                                            <t t-if="appt.state == 'in_progress'">
                                                <span class="appt-pulse-badge"
                                                      style="background:#2e7d32; color:#ffffff;
                                                             padding:8px 22px; border-radius:20px;
                                                             font-weight:700; font-size:1rem;">
                                                    NOW SERVING
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span style="background:#1565c0; color:#ffffff;
                                                             padding:8px 22px; border-radius:20px;
                                                             font-weight:700; font-size:1rem;">
                                                    WAITING
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- Auto-refresh footer -->
                <div class="text-center mt-4">
                    <small style="color:#546e7a;">
                        Screen refreshes automatically every 60 seconds
                    </small>
                </div>

            </div>

            <!-- Auto-refresh script -->
            <script>
                setTimeout(function() {
                    window.location.reload();
                }, 60000);
            </script>

            <!-- Pulse animation for "NOW SERVING" badge -->
            <style>
                @keyframes pulse {
                    0% { opacity: 1; }
                    50% { opacity: 0.5; }
                    100% { opacity: 1; }
                }
                .appt-pulse-badge {
                    animation: pulse 1.5s infinite;
                }
            </style>

        </t>
    </template>

</odoo>