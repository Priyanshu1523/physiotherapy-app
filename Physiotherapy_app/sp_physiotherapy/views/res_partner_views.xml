<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                   PATIENT FORM (inherit)                     -->
    <!-- ============================================================ -->

    <record id="view_res_partner_patient_form" model="ir.ui.view">
        <field name="name">res.partner.patient.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Smart Buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_open_appointments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="not is_patient">
                    <field name="appointment_count"
                           widget="statinfo"
                           string="Appointments"/>
                </button>

                <button name="action_open_prescriptions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not is_patient">
                    <field name="prescription_count"
                           widget="statinfo"
                           string="Prescriptions"/>
                </button>

                <button name="action_open_bills"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="not is_patient">
                    <field name="bill_count"
                           widget="statinfo"
                           string="Bills"/>
                </button>

            </xpath>

            <!-- Personal Info: add patient fields before function -->
            <xpath expr="//field[@name='function']" position="before">
                <field name="is_patient" string="Is Patient"/>
            </xpath>

            <xpath expr="//field[@name='function']" position="after">
                <field name="patient_code" readonly="1"
                       invisible="not is_patient"/>
                <field name="date_of_birth"
                       invisible="not is_patient"/>
                <field name="age" readonly="1"
                       invisible="not is_patient"/>
                <field name="gender" widget="radio"
                       invisible="not is_patient"/>
                <field name="source_id"
                       invisible="not is_patient"/>
            </xpath>

            <!-- Healthcare / Medical Info Tab -->
            <xpath expr="//page[@name='sales_purchases']" position="before">

                <page string="Medical Information"
                      name="medical_information"
                      invisible="not is_patient">
                    <group>
                        <group string="Medical Details">
                            <field name="blood_group"/>
                            <field name="medical_history"
                                   placeholder="Previous surgeries, conditions, ongoing treatments..."/>
                            <field name="allergies"
                                   placeholder="Drug allergies, food allergies..."/>
                        </group>
                        <group string="Emergency Contact">
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone"/>
                        </group>
                    </group>
                </page>

            </xpath>

            <!-- Medical Questionnaires Tab -->
            <xpath expr="//page[@name='sales_purchases']" position="before">

                <page string="Medical Questionnaires"
                      name="medical_questionnaires"
                      invisible="not is_patient">
                    <field name="medical_questionnaire_ids">
                        <list editable="bottom">
                            <field name="question_id"/>
                            <field name="response"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>

            </xpath>

            <!-- X-Ray Reports Tab -->
            <xpath expr="//page[@name='sales_purchases']" position="before">

                <page string="X-Ray Reports"
                      name="xray_reports"
                      invisible="not is_patient">
                    <field name="xray_report_ids"
                           widget="kanban"
                           options="{'no_create_edit': True}">
                        <kanban class="o_kanban_small_column">
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_global_click o_kanban_card">
                                        <div class="d-flex align-items-start">
                                            <div class="me-2">
                                                <field name="scan_image"
                                                       widget="image"
                                                       options="{'size': [64, 64], 'preview_image': 'scan_image'}"
                                                       class="o_kanban_image o_image_64_cover"/>
                                            </div>
                                            <div class="oe_kanban_details">
                                                <strong>
                                                    <field name="image_filename"/>
                                                </strong>
                                                <div class="text-muted">
                                                    <field name="description"/>
                                                </div>
                                                <div class="text-muted">
                                                    <field name="report_date"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>

            </xpath>

        </field>
    </record>

    <!-- Remove required from Account Payable and Account Receivable -->
    <record id="view_partner_accounting_not_required" model="ir.ui.view">
        <field name="name">res.partner.accounting.not.required</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_receivable_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='property_account_payable_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                      PATIENT LIST VIEW                       -->
    <!-- ============================================================ -->

    <record id="view_res_partner_patient_list" model="ir.ui.view">
        <field name="name">res.partner.patient.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Patients"
                  decoration-info="is_patient"
                  decoration-muted="not active">
                <field name="patient_code"/>
                <field name="name" string="Patient Name"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
                <field name="appointment_count" string="Appointments"/>
                <field name="is_patient" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                     PATIENT KANBAN VIEW                      -->
    <!-- ============================================================ -->

    <record id="view_res_partner_patient_kanban" model="ir.ui.view">
        <field name="name">res.partner.patient.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="patient_code"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="image_128"/>
                <field name="appointment_count"/>

                <templates>
                    <t t-name="card">
                        <aside>
                            <field name="image_128"
                                   widget="image"
                                   options="{'preview_image': 'image_128'}"/>
                        </aside>
                        <main>
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="patient_code"/> |
                                Age: <field name="age"/> |
                                <field name="gender"/>
                            </div>
                            <div>
                                <i class="fa fa-phone me-1"/><field name="phone"/>
                            </div>
                            <div>
                                <i class="fa fa-envelope me-1"/><field name="email"/>
                            </div>
                            <div>
                                <field name="appointment_count"/> Appointments
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                     PATIENT SEARCH VIEW                      -->
    <!-- ============================================================ -->

    <record id="view_res_partner_patient_search" model="ir.ui.view">
        <field name="name">res.partner.patient.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <field name="name"
                       filter_domain="['|', ('name', 'ilike', self), ('patient_code', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="gender"/>
                <field name="blood_group"/>

                <filter name="filter_is_patient"
                        string="Patients Only"
                        domain="[('is_patient', '=', True)]"/>
                <filter name="filter_male"
                        string="Male"
                        domain="[('gender', '=', 'male')]"/>
                <filter name="filter_female"
                        string="Female"
                        domain="[('gender', '=', 'female')]"/>

                <separator/>

                <group>
                    <filter name="group_by_gender"
                            string="Gender"
                            domain="[]" context="{'group_by': 'gender'}"/>
                    <filter name="group_by_blood_group"
                            string="Blood Group"
                            domain="[]" context="{'group_by': 'blood_group'}"/>
                    <filter name="group_by_source"
                            string="Referral Source"
                            domain="[]" context="{'group_by': 'source_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    PATIENT ACTION WINDOW                     -->
    <!-- ============================================================ -->

    <record id="action_patient_list" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{
            'default_is_patient': True,
            'search_default_filter_is_patient': 1,
        }</field>
        <field name="search_view_id" ref="view_res_partner_patient_search"/>
    </record>

    <record id="action_patient_list_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_res_partner_patient_list"/>
        <field name="act_window_id" ref="action_patient_list"/>
    </record>

    <record id="action_patient_list_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_res_partner_patient_kanban"/>
        <field name="act_window_id" ref="action_patient_list"/>
    </record>

</odoo>
