<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--          MEDICINE FORM (inherit product.template)            -->
    <!-- ============================================================ -->

    <record id="view_product_template_medicine_form" model="ir.ui.view">
        <field name="name">product.template.medicine.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_medicine"/>
                    <label for="is_medicine"/>
                </span>
            </xpath>
            <xpath expr="//field[@name='type']" position="before">
                <field name="generic_name"
                       invisible="not is_medicine"/>
                <field name="dosage_strength"
                       invisible="not is_medicine"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--          MEDICINE LIST (inherit product.template)            -->
    <!-- ============================================================ -->

    <record id="view_product_template_medicine_list" model="ir.ui.view">
        <field name="name">product.template.medicine.list.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="generic_name" optional="show"/>
                <field name="dosage_strength" optional="show"/>
                <field name="is_medicine" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                   MEDICINE ACTION WINDOW                     -->
    <!-- ============================================================ -->

    <record id="action_medical_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_medicine', '=', True)]</field>
        <field name="context">{
            'default_is_medicine': True,
            'default_type': 'consu',
        }</field>
    </record>

</odoo>
