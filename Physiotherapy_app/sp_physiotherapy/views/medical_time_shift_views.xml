<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                    TIME SHIFT LIST VIEW                      -->
    <!-- ============================================================ -->

    <record id="view_medical_time_shift_list" model="ir.ui.view">
        <field name="name">medical.time.shift.list</field>
        <field name="model">medical.time.shift</field>
        <field name="arch" type="xml">
            <list string="Time Shifts">
                <field name="name"/>
                <field name="shift_type"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="slot_duration"/>
                <field name="max_appointments"/>
                <field name="working_day_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    TIME SHIFT FORM VIEW                      -->
    <!-- ============================================================ -->

    <record id="view_medical_time_shift_form" model="ir.ui.view">
        <field name="name">medical.time.shift.form</field>
        <field name="model">medical.time.shift</field>
        <field name="arch" type="xml">
            <form string="Time Shift">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shift Configuration">
                            <field name="shift_type"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                        <group string="Appointment Settings">
                            <field name="slot_duration"/>
                            <field name="max_appointments"/>
                        </group>
                    </group>
                    <group string="Working Days">
                        <field name="working_day_ids" widget="many2many_tags"
                               nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                   TIME SHIFT ACTION WINDOW                   -->
    <!-- ============================================================ -->

    <record id="action_medical_time_shift" model="ir.actions.act_window">
        <field name="name">Time Shifts</field>
        <field name="res_model">medical.time.shift</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
