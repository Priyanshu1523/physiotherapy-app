    <menuitem id="menu_patient"
              name="Patients"
              parent="menu_physiotherapy_root"
              action="action_patient_list"
              sequence="20"/>

    <!-- ============================================================ -->
    <!--                    PRESCRIPTIONS                             -->
    <!-- ============================================================ -->

    <menuitem id="menu_prescription"
              name="Prescriptions"
              parent="menu_physiotherapy_root"
              action="action_medical_prescription"
              sequence="30"/>

