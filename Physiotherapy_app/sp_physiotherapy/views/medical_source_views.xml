<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                  PATIENT SOURCE LIST VIEW                    -->
    <!-- ============================================================ -->

    <record id="view_medical_source_list" model="ir.ui.view">
        <field name="name">medical.source.list</field>
        <field name="model">medical.source</field>
        <field name="arch" type="xml">
            <list string="Patient Sources" editable="bottom">
                <field name="name" required="True"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                 PATIENT SOURCE ACTION WINDOW                 -->
    <!-- ============================================================ -->

    <record id="action_medical_source" model="ir.actions.act_window">
        <field name="name">Patient Sources</field>
        <field name="res_model">medical.source</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
