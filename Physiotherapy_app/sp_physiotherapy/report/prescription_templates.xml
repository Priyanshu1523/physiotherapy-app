<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_prescription_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page"
                         style="font-family: 'Helvetica', 'Arial', sans-serif;
                                font-size: 13px;
                                color: #222;">
                        <div style="text-align: center;
                                    border-bottom: 3px solid #2c3e50;
                                    padding-bottom: 12px;
                                    margin-bottom: 16px;">
                            <t t-if="doc.env.company.logo">
                                <img t-att-src="image_data_uri(doc.env.company.logo)"
                                     style="max-height: 60px; margin-bottom: 6px;"
                                     alt="Clinic Logo"/>
                                <br/>
                            </t>
                            <h2 style="margin: 0;
                                       font-weight: 800;
                                       letter-spacing: 2px;
                                       color: #2c3e50;">
                                PRESCRIPTION
                            </h2>
                            <div style="font-size: 11px; color: #777; margin-top: 2px;">
                                Professional Medical Care
                            </div>
                        </div>

                        <!-- PRESCRIPTION INFO -->
                        <table style="width: 100%;
                                      border-collapse: collapse;
                                      margin-bottom: 14px;
                                      border: 1px solid #ccc;">
                            <tr style="background: #f5f5f5;">
                                <td style="padding: 8px; border: 1px solid #ccc; width: 33%;">
                                    <strong>Prescription No</strong><br/>
                                    <span t-field="doc.sequence_no"/>
                                </td>
                                <td style="padding: 8px; border: 1px solid #ccc; width: 34%;">
                                    <strong>Date</strong><br/>
                                    <span t-field="doc.prescription_date"/>
                                </td>
                                <td style="padding: 8px; border: 1px solid #ccc; width: 33%;">
                                    <strong>Appointment No</strong><br/>
                                    <span t-field="doc.appointment_id.appointment_no"/>
                                </td>
                            </tr>
                        </table>

                        <!-- PATIENT AND DOCTOR INFO -->
                        <table style="width: 100%;
                                      border-collapse: collapse;
                                      margin-bottom: 14px;
                                      border: 1px solid #ccc;">
                            <tr>
                                <td style="padding: 8px;
                                           border: 1px solid #ccc;
                                           width: 50%;
                                           vertical-align: top;">
                                    <strong style="color: #2c3e50;">Patient Information</strong>
                                    <table style="width: 100%; margin-top: 6px;">
                                        <tr>
                                            <td style="padding: 3px 0; width: 40%; color: #555;">Name</td>
                                            <td style="padding: 3px 0;">
                                                <span t-field="doc.patient_id.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0; color: #555;">Patient ID</td>
                                            <td style="padding: 3px 0;">
                                                <span t-field="doc.patient_id.patient_code"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0; color: #555;">Age</td>
                                            <td style="padding: 3px 0;">
                                                <span t-field="doc.patient_id.age"/> years
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0; color: #555;">Gender</td>
                                            <td style="padding: 3px 0;">
                                                <span t-field="doc.patient_id.gender"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="padding: 8px;
                                           border: 1px solid #ccc;
                                           width: 50%;
                                           vertical-align: top;">
                                    <strong style="color: #2c3e50;">Doctor Information</strong>
                                    <table style="width: 100%; margin-top: 6px;">
                                        <tr>
                                            <td style="padding: 3px 0; width: 45%; color: #555;">Doctor</td>
                                            <td style="padding: 3px 0;">
                                                <span t-field="doc.prescribed_doctor_id.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0; color: #555;">Specialization</td>
                                            <td style="padding: 3px 0;">
                                                <span t-field="doc.prescribed_doctor_id.specialization_id.name"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- TREATMENT -->
                        <t t-if="doc.treatment_id">
                            <div style="background: #eaf2f8;
                                        border: 1px solid #aed6f1;
                                        border-radius: 4px;
                                        padding: 8px 12px;
                                        margin-bottom: 14px;">
                                <strong style="color: #2c3e50;">Treatment:</strong>
                                <span t-field="doc.treatment_id.name" style="margin-left: 8px;"/>
                            </div>
                        </t>

                        <!-- RX SYMBOL -->
                        <div style="margin-bottom: 6px;">
                            <span style="font-size: 30px; font-weight: 700; color: #2c3e50;">&#8478;</span>
                        </div>

                        <!-- MEDICINE TABLE -->
                        <table style="width: 100%;
                                      border-collapse: collapse;
                                      margin-bottom: 18px;"
                               border="0">
                            <thead>
                                <tr style="background: #2c3e50; color: #fff;">
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: left;">#</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: left;">Medicine</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: left;">Form</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: left;">Dosage</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: center;">Qty</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: right;">Price</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: center;">M</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: center;">A</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: center;">E</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: center;">N</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: center;">Before Food</th>
                                    <th style="padding: 7px; border: 1px solid #2c3e50; text-align: center;">Days</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_no" t-value="0"/>
                                <t t-foreach="doc.medicine_line_ids" t-as="med">
                                    <t t-set="line_no" t-value="line_no + 1"/>
                                    <tr t-att-style="'background: #f9f9f9;' if line_no % 2 == 0 else ''">
                                        <td style="padding: 6px; border: 1px solid #ddd;">
                                            <span t-esc="line_no"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd;">
                                            <strong t-field="med.medicament_id.name"/>
                                            <t t-if="med.generic_name">
                                                <br/>
                                                <small style="color: #777;">
                                                    <span t-field="med.generic_name"/>
                                                </small>
                                            </t>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd;">
                                            <span t-field="med.form"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd;">
                                            <span t-field="med.dosage_strength"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">
                                            <span t-field="med.quantity"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: right;">
                                            <span t-field="med.unit_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">
                                            <t t-if="med.morning">&#10004;</t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">
                                            <t t-if="med.afternoon">&#10004;</t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">
                                            <t t-if="med.evening">&#10004;</t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">
                                            <t t-if="med.night">&#10004;</t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">
                                            <t t-if="med.before_food">Before</t>
                                            <t t-else="">After</t>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">
                                            <span t-field="med.duration_days"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- NOTES -->
                        <t t-if="doc.notes">
                            <div style="border: 1px solid #ddd;
                                        border-radius: 4px;
                                        padding: 10px 14px;
                                        margin-bottom: 18px;
                                        background: #fffde7;">
                                <strong style="color: #2c3e50;">Notes:</strong><br/>
                                <span t-field="doc.notes"/>
                            </div>
                        </t>

                        <!-- FOOTER -->
                        <div style="margin-top: 20px;
                                    border-top: 2px solid #2c3e50;
                                    padding-top: 12px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 60%; vertical-align: top;">
                                        <strong>Doctor's Instructions:</strong><br/>
                                        <span style="font-size: 12px; color: #555;">
                                            Please follow the prescribed dosage carefully
                                            and complete the full course of medication.
                                            Contact the clinic if you experience any
                                            adverse reactions.
                                        </span>
                                    </td>
                                    <td style="width: 40%; text-align: right; vertical-align: top;">
                                        <br/><br/>
                                        <div style="border-top: 1px solid #000;
                                                    display: inline-block;
                                                    min-width: 200px;
                                                    padding-top: 4px;
                                                    text-align: center;">
                                            <strong>
                                                Dr. <span t-field="doc.prescribed_doctor_id.name"/>
                                            </strong>
                                            <br/>
                                            <small style="color: #777;">
                                                <span t-field="doc.prescribed_doctor_id.specialization_id.name"/>
                                            </small>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- QR CODES -->
                        <t t-if="doc.appointment_id.booking_qr or doc.appointment_id.appointment_qr">
                            <div style="margin-top: 20px;
                                        border-top: 1px solid #ddd;
                                        padding-top: 14px;">
                                <table style="width: 100%;">
                                    <tr>
                                        <t t-if="doc.appointment_id.booking_qr">
                                            <td style="width: 50%; text-align: center;">
                                                <strong style="font-size: 11px;">Book New Appointment</strong>
                                                <br/>
                                                <img t-att-src="image_data_uri(doc.appointment_id.booking_qr)"
                                                     style="width: 100px; height: 100px; margin-top: 4px;"/>
                                                <br/>
                                                <small style="font-size: 9px; color: #888;">
                                                    Scan to book
                                                </small>
                                            </td>
                                        </t>
                                        <t t-if="doc.appointment_id.appointment_qr">
                                            <td style="width: 50%; text-align: center;">
                                                <strong style="font-size: 11px;">View Appointment</strong>
                                                <br/>
                                                <img t-att-src="image_data_uri(doc.appointment_id.appointment_qr)"
                                                     style="width: 100px; height: 100px; margin-top: 4px;"/>
                                                <br/>
                                                <small style="font-size: 9px; color: #888;">
                                                    Scan to view details
                                                </small>
                                            </td>
                                        </t>
                                    </tr>
                                </table>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>