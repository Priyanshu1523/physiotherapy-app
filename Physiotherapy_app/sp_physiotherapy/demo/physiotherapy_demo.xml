            <field name="consultation_fee">150</field>
            <field name="state">confirmed</field>
            <field name="notes">Demo appointment</field>
        </record>
        <record id="demo_appointment_6" model="medical.appointment" context="{'physio_skip_validation': True, 'tracking_disable': True, 'mail_notrack': True}">
