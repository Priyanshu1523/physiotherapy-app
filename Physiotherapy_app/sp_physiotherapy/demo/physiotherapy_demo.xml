<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Patient sources and intake questions -->
        <record id="demo_source_1" model="medical.source"><field name="name">Walk-in</field></record>
        <record id="demo_source_2" model="medical.source"><field name="name">Doctor Referral</field></record>
        <record id="demo_source_3" model="medical.source"><field name="name">Website</field></record>
        <record id="demo_source_4" model="medical.source"><field name="name">Social Media</field></record>
        <record id="demo_question_1" model="medical.question"><field name="question_text">Do you have any past surgery?</field></record>
        <record id="demo_question_2" model="medical.question"><field name="question_text">Are you currently on any medication?</field></record>
        <record id="demo_question_3" model="medical.question"><field name="question_text">Where do you feel the pain?</field></record>
        <record id="demo_question_4" model="medical.question"><field name="question_text">How long have you had this problem?</field></record>

