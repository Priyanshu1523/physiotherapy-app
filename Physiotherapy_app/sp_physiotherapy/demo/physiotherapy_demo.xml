        <!-- X-ray reports -->
        <record id="demo_xray_1" model="xray.report" context="{'tracking_disable': True}">
            <field name="patient_id" ref="demo_patient_1"/>
            <field name="report_date" eval="(DateTime.now() + timedelta(days=-7)).date()"/>
            <field name="description">X-ray lumbar spine AP/lateral: mild disc space narrowing at L4-L5. No fracture.</field>
            <field name="scan_image" type="base64" file="sp_physiotherapy/demo/xray_1.png"/>
            <field name="image_filename">xray_1.png</field>
        </record>
        <record id="demo_xray_2" model="xray.report" context="{'tracking_disable': True}">
            <field name="patient_id" ref="demo_patient_2"/>
            <field name="report_date" eval="(DateTime.now() + timedelta(days=-5)).date()"/>
            <field name="description">X-ray left knee: no bony injury. Mild joint effusion, soft tissue strain suspected.</field>
            <field name="scan_image" type="base64" file="sp_physiotherapy/demo/xray_2.png"/>
            <field name="image_filename">xray_2.png</field>
        </record>
        <record id="demo_xray_3" model="xray.report" context="{'tracking_disable': True}">
            <field name="patient_id" ref="demo_patient_3"/>
            <field name="report_date" eval="(DateTime.now() + timedelta(days=-2)).date()"/>
