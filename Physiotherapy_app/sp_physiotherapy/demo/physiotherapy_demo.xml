            <field name="scan_image" type="base64" file="sp_physiotherapy/demo/xray_3.png"/>
            <field name="image_filename">xray_3.png</field>
        </record>

        <!-- Prescription lines -->
        <record id="demo_presc_line_1" model="medical.prescription.line">
            <field name="prescription_id" ref="demo_prescription_1"/>
            <field name="medicament_id" ref="demo_medicine_1"/>
            <field name="form">tablet</field>
            <field name="quantity">10</field>
            <field name="morning" eval="True"/>
            <field name="afternoon" eval="False"/>
            <field name="evening" eval="True"/>
            <field name="night" eval="False"/>
            <field name="before_food" eval="False"/>
            <field name="duration_days">5</field>
        </record>
        <record id="demo_presc_line_2" model="medical.prescription.line">
            <field name="prescription_id" ref="demo_prescription_1"/>
            <field name="medicament_id" ref="demo_medicine_2"/>
            <field name="form">ointment</field>
            <field name="quantity">1</field>
