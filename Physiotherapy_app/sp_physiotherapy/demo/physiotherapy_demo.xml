        <record id="demo_presc_line_4" model="medical.prescription.line">
            <field name="prescription_id" ref="demo_prescription_3"/>
            <field name="medicament_id" ref="demo_medicine_4"/>
            <field name="form">tablet</field>
            <field name="quantity">15</field>
            <field name="morning" eval="True"/>
            <field name="afternoon" eval="False"/>
            <field name="evening" eval="False"/>
            <field name="night" eval="False"/>
            <field name="before_food" eval="False"/>
