            <field name="date_of_birth">1978-11-10</field>
            <field name="work_email">arvind.nair@clinic.com</field>
            <field name="mobile_phone">+91 91234 56789</field>
            <field name="time_shift_ids" eval="[(6, 0, [ref('shift_morning'),ref('shift_evening')])]"/>
        </record>
        <record id="demo_doctor_2" model="hr.employee" context="{'tracking_disable': True}">
            <field name="name">Dr. Meena Joshi</field>
