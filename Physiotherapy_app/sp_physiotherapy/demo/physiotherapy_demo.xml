        <!-- Treatment prices -->
        <record id="treatment_manual_therapy" model="medical.treatment"><field name="cost">500</field></record>
        <record id="treatment_electrotherapy" model="medical.treatment"><field name="cost">800</field></record>
        <record id="treatment_therapeutic_exercise" model="medical.treatment"><field name="cost">300</field></record>
        <record id="treatment_postural_assessment" model="medical.treatment"><field name="cost">400</field></record>
        <record id="treatment_routine_checkup" model="medical.treatment"><field name="cost">250</field></record>

        <!-- Medicines -->
        <record id="demo_medicine_1" model="product.template">
            <field name="name">Ibuprofen 400mg</field>
            <field name="is_medicine" eval="True"/>
            <field name="generic_name">Ibuprofen</field>
            <field name="dosage_strength">400</field>
            <field name="list_price">12</field>
        </record>
        <record id="demo_medicine_2" model="product.template">
            <field name="name">Diclofenac Gel</field>
            <field name="is_medicine" eval="True"/>
            <field name="generic_name">Diclofenac Sodium</field>
            <field name="dosage_strength">500</field>
            <field name="list_price">85</field>
        </record>
        <record id="demo_medicine_3" model="product.template">
