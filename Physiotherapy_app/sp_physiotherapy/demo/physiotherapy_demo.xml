        <!-- Equipment -->
        <record id="demo_equipment_product_1" model="product.product">
            <field name="name">Ultrasound Therapy Unit</field>
            <field name="type">consu</field>
        </record>
        <record id="demo_equipment_product_2" model="product.product">
            <field name="name">TENS Machine</field>
            <field name="type">consu</field>
        </record>
        <record id="demo_equipment_product_3" model="product.product">
            <field name="name">Treadmill</field>
            <field name="type">consu</field>
        </record>
        <record id="demo_equipment_1" model="medical.equipment">
            <field name="name">Ultrasound Therapy Unit</field>
            <field name="product_id" ref="demo_equipment_product_1"/>
            <field name="serial_number">UST-1001</field>
            <field name="department">Electrotherapy</field>
            <field name="state">active</field>
        </record>
        <record id="demo_equipment_2" model="medical.equipment">
            <field name="name">TENS Machine</field>
            <field name="product_id" ref="demo_equipment_product_2"/>
            <field name="serial_number">TENS-2002</field>
            <field name="department">Electrotherapy</field>
            <field name="state">active</field>
        </record>
        <record id="demo_equipment_3" model="medical.equipment">
            <field name="name">Treadmill</field>
            <field name="product_id" ref="demo_equipment_product_3"/>
            <field name="serial_number">TRD-3003</field>
            <field name="department">Rehabilitation</field>
            <field name="state">active</field>
        </record>

        <!-- Appointments (UTC times; shown in the user timezone, IST assumed) -->
        <record id="demo_appointment_1" model="medical.appointment" context="{'physio_skip_validation': True, 'tracking_disable': True, 'mail_notrack': True}">
            <field name="patient_id" ref="demo_patient_1"/>
            <field name="doctor_id" ref="demo_doctor_1"/>
            <field name="shift_id" ref="shift_morning"/>
            <field name="appointment_date"
                   eval="(DateTime.now() + timedelta(days=-7)).replace(hour=1, minute=30, second=0, microsecond=0)"/>
            <field name="slot_duration">30</field>
            <field name="consultation_fee">150</field>
            <field name="state">done</field>
            <field name="notes">Demo appointment</field>
        </record>
        <record id="demo_appointment_2" model="medical.appointment" context="{'physio_skip_validation': True, 'tracking_disable': True, 'mail_notrack': True}">
            <field name="patient_id" ref="demo_patient_2"/>
            <field name="doctor_id" ref="demo_doctor_2"/>
            <field name="shift_id" ref="shift_day"/>
            <field name="appointment_date"
                   eval="(DateTime.now() + timedelta(days=-5)).replace(hour=5, minute=0, second=0, microsecond=0)"/>
            <field name="slot_duration">30</field>
            <field name="consultation_fee">200</field>
            <field name="state">done</field>
            <field name="notes">Demo appointment</field>
