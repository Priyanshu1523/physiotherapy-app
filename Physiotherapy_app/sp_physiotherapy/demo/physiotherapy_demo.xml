                   eval="(DateTime.now() + timedelta(days=0)).replace(hour=12, minute=30, second=0, microsecond=0)"/>
            <field name="slot_duration">30</field>
            <field name="consultation_fee">200</field>
            <field name="state">in_progress</field>
            <field name="notes">Demo appointment</field>
        </record>
        <record id="demo_appointment_5" model="medical.appointment" context="{'physio_skip_validation': True, 'tracking_disable': True, 'mail_notrack': True}">
