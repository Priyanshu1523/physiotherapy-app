        <record id="demo_patient_4" model="res.partner" context="{'tracking_disable': True}">
            <field name="name">Sneha Shah</field>
            <field name="is_patient" eval="True"/>
            <field name="date_of_birth">1995-06-18</field>
            <field name="gender">female</field>
            <field name="blood_group">ab+</field>
            <field name="email">sneha.shah@example.com</field>
            <field name="phone">+91 90000 00004</field>
            <field name="medical_history">Frozen shoulder (right)</field>
            <field name="allergies">None</field>
            <field name="emergency_contact_name">Jay Shah</field>
            <field name="emergency_contact_phone">+91 98765 33445</field>
            <field name="source_id" ref="demo_source_4"/>
        </record>
        <record id="demo_patient_5" model="res.partner" context="{'tracking_disable': True}">
            <field name="name">Amit Joshi</field>
            <field name="is_patient" eval="True"/>
            <field name="date_of_birth">1969-01-27</field>
            <field name="gender">male</field>
            <field name="blood_group">o-</field>
            <field name="email">amit.joshi@example.com</field>
            <field name="phone">+91 90000 00005</field>
            <field name="medical_history">Post knee replacement rehab</field>
            <field name="allergies">Dust</field>
