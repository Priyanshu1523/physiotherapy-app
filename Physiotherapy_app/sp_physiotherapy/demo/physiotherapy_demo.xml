            <field name="consultation_fee">200</field>
            <field name="state">cancelled</field>
            <field name="notes">Demo appointment</field>
        </record>

        <!-- Prescriptions for completed appointments -->
        <record id="demo_prescription_1" model="medical.prescription" context="{'physio_skip_validation': True, 'tracking_disable': True, 'mail_notrack': True}">
            <field name="appointment_id" ref="demo_appointment_1"/>
            <field name="patient_id" ref="demo_patient_1"/>
            <field name="prescribed_doctor_id" ref="demo_doctor_1"/>
            <field name="treatment_id" ref="treatment_manual_therapy"/>
            <field name="treatment_cost">500</field>
            <field name="prescription_date" eval="(DateTime.now() - timedelta(days=7)).date()"/>
            <field name="notes">Demo prescription</field>
            <field name="state">prescribed</field>
        </record>
        <record id="demo_prescription_2" model="medical.prescription" context="{'physio_skip_validation': True, 'tracking_disable': True, 'mail_notrack': True}">
            <field name="appointment_id" ref="demo_appointment_2"/>
            <field name="patient_id" ref="demo_patient_2"/>
            <field name="prescribed_doctor_id" ref="demo_doctor_2"/>
