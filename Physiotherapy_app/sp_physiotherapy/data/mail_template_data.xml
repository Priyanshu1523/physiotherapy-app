<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="mail_template_appointment_confirmed" model="mail.template">
        <field name="name">Appointment Confirmation</field>
        <field name="model_id" ref="model_medical_appointment"/>
        <field name="email_from">{{ (object.doctor_id.work_email or user.email) }}</field>
        <field name="email_to">{{ object.patient_id.email }}</field>
        <field name="subject">Appointment Confirmed - {{ object.appointment_no }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <p>Dear <t t-out="object.patient_id.name"/>,</p>
    <p>Your appointment has been confirmed with the following details:</p>
    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Appointment No.</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.appointment_no"/></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Doctor</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.doctor_id.name"/></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Date &amp; Time</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.appointment_date" t-options='{"widget": "datetime", "format": "dd MMM yyyy hh:mm a"}'/></td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Duration</td>
            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.slot_duration"/> Minutes</td>
        </tr>
    </table>
    <t t-if="object.zoom_meeting_url">
        <p>This is a video consultation. Join the meeting at your appointment time:</p>
        <p style="margin: 12px 0;">
            <a t-att-href="object.zoom_meeting_url"
               style="background-color: #2D8CFF; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: bold;">
                Join Zoom Meeting
            </a>
        </p>
        <p style="font-size: 12px; color: #666666;">
            Meeting ID: <t t-out="object.zoom_meeting_id"/><br/>
            Link: <t t-out="object.zoom_meeting_url"/>
        </p>
    </t>
    <t t-else="">
        <p>Please arrive 10 minutes before your scheduled time.</p>
    </t>
    <p>Best regards,<br/>The Clinic Team</p>
</div>
        </field>
    </record>
</odoo>