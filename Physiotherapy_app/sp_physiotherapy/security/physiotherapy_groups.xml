<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.module.category"
            id="module_category_physiotherapy">
        <field name="name">Physiotherapy Management</field>
        <field name="sequence">5</field>
    </record>

    <record model="res.groups.privilege"
            id="privilege_physiotherapy">
        <field name="name">Physiotherapy</field>
        <field name="sequence">1</field>
        <field name="category_id"
               ref="module_category_physiotherapy"/>
        <field name="placeholder">Select Role</field>
    </record>

    <!-- User group (base access) -->
    <record id="group_physiotherapy_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">1</field>
        <field name="privilege_id"
               ref="privilege_physiotherapy"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">
            Basic access to physiotherapy module.
        </field>
    </record>

    <!-- Doctor group (implies User) -->
    <record id="group_physiotherapy_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="sequence">5</field>
        <field name="privilege_id"
               ref="privilege_physiotherapy"/>
        <field name="implied_ids"
               eval="[(4, ref('group_physiotherapy_user'))]"/>
        <field name="comment">
            Doctors can manage their own appointments
            and prescriptions.
        </field>
    </record>

    <!-- Admin group (implies Doctor) -->
    <record id="group_physiotherapy_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id"
               ref="privilege_physiotherapy"/>
        <field name="implied_ids"
               eval="[(4, ref('group_physiotherapy_doctor'))]"/>
        <field name="comment">
            Full access to all physiotherapy features
            and configuration.
        </field>
    </record>
</odoo>
