# Payment Gateway Public Keys & UPI VPA
VITE_UPI_VPA=physiocare@icici
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
VITE_ENABLE_ONLINE_PAYMENTS=true
