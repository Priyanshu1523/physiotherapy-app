# ====================================================================
# PHYSIOCARE BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your credentials.
# ====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=physiotherapy_db

# Full Database Connection String
DATABASE_URL=postgres://postgres:your_password@localhost:5432/physiotherapy_db

# --------------------------------------------------------------------
# Payment Gateway Configuration (UPI & Razorpay)
# --------------------------------------------------------------------
UPI_MERCHANT_VPA=physiocare@icici
UPI_MERCHANT_NAME=PhysioCare Clinic & Rehabilitation Center

RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# --------------------------------------------------------------------
# Clinic Profile
# --------------------------------------------------------------------
CLINIC_NAME=PhysioCare Clinic & Rehabilitation Center
CLINIC_PHONE=+91 98765 43210
CLINIC_EMAIL=info@physioclinic.com
CLINIC_GSTIN=24AAACP1234A1Z5
CLINIC_ADDRESS=Opp. Health Park, S.G. Highway, Ahmedabad - 380054
